// LivePaper resource script.
//
// Only two resources, both built into the exe so the product is a single file:
//   * the application icon (used by the exe, the taskbar and the tray fallback)
//   * an application manifest that declares system DPI awareness
//
// The manifest is written inline rather than via CREATEPROCESS_MANIFEST_RESOURCE_ID
// with a file reference so windres cannot silently drop it.

#include <windows.h>

1 RT_MANIFEST "livepaper.manifest"

// Icon: id 1 is the "main" icon used for the executable itself.
1 ICON "livepaper.ico"

// Version information, shown in the file properties dialog.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "LivePaper"
            VALUE "FileDescription",  "Live Shan Shui - infinite ink landscape"
            VALUE "FileVersion",      "2.1.0.0"
            VALUE "InternalName",     "LiveShanShui"
            VALUE "OriginalFilename", "LiveShanShui.exe"
            VALUE "ProductName",      "Live Shan Shui"
            VALUE "ProductVersion",   "2.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
